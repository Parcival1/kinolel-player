#pragma code_page(65001)
// KinoLel: Versionsangaben der Programmdatei (Pflicht fuer Code-Signatur ueber SignPath: Produktname/Version gesetzt).
// Werte aus marke.cmake, eingesetzt von CMake (src/CMakeLists.txt).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @KINOLEL_VERSION_KOMMA@
 PRODUCTVERSION @KINOLEL_VERSION_KOMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704b0"
        BEGIN
            VALUE "CompanyName", "@APP_PUBLISHER@"
            VALUE "FileDescription", "@APP_NAME@ - @APP_DESCRIPTION@"
            VALUE "FileVersion", "@VERSION_STRING@"
            VALUE "InternalName", "@APP_NAME@"
            VALUE "LegalCopyright", "GPL-2.0 - based on Jellyfin Desktop"
            VALUE "OriginalFilename", "@MAIN_NAME@.exe"
            VALUE "ProductName", "@APP_NAME@"
            VALUE "ProductVersion", "@VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1200
    END
END
